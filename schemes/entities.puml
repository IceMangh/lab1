@startuml
!pragma layout smetana

skinparam shadowing false
skinparam dpi 216
skinparam ranksep 60
skinparam nodesep 75
skinparam class {
    BackgroundColor White
    BorderColor #052984
    FontColor #223247
}
skinparam ArrowColor #526984
hide circle
hide empty methods

entity "Структура данных" as Structure {
    тип элементов
    правила хранения
}

entity "Элемент" as Element {
    значение
}

entity "Операция" as Operation {
    параметры
    результат
}

Structure --> Element : содержит
Structure --> Operation : поддерживает
Element <-- Operation : обрабатывает
@enduml
